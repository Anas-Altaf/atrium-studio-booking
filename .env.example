# Local docker compose already sets these. Copy to .env only when running the
# API outside compose, or when pointing the seed at a remote database.

DATABASE_URL=postgres://atrium:atrium@localhost:5432/atrium
JWT_SECRET=change-me
PORT=3000
INSTANCE_ID=api-local

# Origins allowed to call this API from a browser, comma separated.
# Unset means none: the API trusts nothing rather than everything, so a
# forgotten variable fails closed. Bearer tokens, not cookies, so credentials
# are never sent cross-origin.
#   local frontend   http://localhost:3000
#   deployed         https://<your-app>.vercel.app     (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Paygate is designed in ARCHITECTURE.md 4 but not implemented. Kept so the
# variables are named in one place if it is built.
PAYGATE_URL=http://localhost:4000
PAYGATE_SECRET=change-me
