{
  "name": "atrium-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "proof": "tsx tests/concurrency-proof.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8",
    "fastify-plugin": "^4.5.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.1.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
